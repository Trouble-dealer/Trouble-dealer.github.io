---
import { siteConfig } from '../../site.config.mjs';
import { categoryUrl, getPosts, homePosts, taxonomy, url } from '../lib/blog';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
interface Props { current?: number; }
const { current = 1 } = Astro.props;
const posts = await getPosts();
const ordered = homePosts(posts);
const shown = ordered.slice((current - 1) * siteConfig.postsPerPage, current * siteConfig.postsPerPage);
---
<div class="feed-heading"><h2>最新记录</h2><span>{posts.length} POSTS · 慢慢更新中</span></div>
<nav class="feed-filters" aria-label="按分类阅读"><a href={url('')} class="active" aria-current="page">全部文章</a>{taxonomy(posts, 'category').map(([name]) => <a href={categoryUrl(name)}>{name}</a>)}</nav>
<div class="post-list">{shown.map((post, index) => <PostCard post={post} index={(current - 1) * siteConfig.postsPerPage + index}/>)}</div>
{posts.length === 0 && <div class="card empty-state"><h2>故事即将开始</h2><p>还没有发布的文章，欢迎稍后回来看看。</p></div>}
<Pagination current={current} total={Math.ceil(posts.length / siteConfig.postsPerPage)}/>
