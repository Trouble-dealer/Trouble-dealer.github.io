---
import { authEnabled, backendConfig } from '../lib/backend';
import { url } from '../lib/blog';
interface Props { postId: string; }
const { postId } = Astro.props;
---
<section class="card comments-card" id="comments" data-post={postId} data-auth={authEnabled}>
  <div class="comments-heading"><div><p class="eyebrow">LET'S TALK ABOUT IT</p><h2>文章交流</h2></div>{backendConfig.configured && <button type="button" class="button secondary" id="comments-refresh" hidden>刷新评论</button>}</div>
  <p class="form-help">友善交流，专注内容。新评论审核后公开；邮箱不会出现在评论中。</p>
  {!authEnabled && <p class="community-notice">注册与评论提交暂未开放，正在完成邮箱服务配置。</p>}
  {backendConfig.configured && <>
    <p id="comments-status" class="form-status" role="status" aria-live="polite">正在加载评论…</p>
    <div id="comments-list" class="comments-list"></div>
    <button class="button secondary" id="comments-more" type="button" hidden>加载更早的评论</button>
    {authEnabled && <div class="comment-editor"><p id="comment-guest" hidden><a href={`${url('account/')}?next=${encodeURIComponent(url(`posts/${postId}/#comments`))}`}>登录或注册</a>后参与讨论。</p><form id="comment-form" class="stack-form" hidden><label for="comment-body">写下你的想法</label><textarea id="comment-body" name="body" minlength="3" maxlength="2000" rows="5" required placeholder="3～2000 字；不支持 HTML 或 Markdown。"></textarea><p class="form-help">不要填写密码、私人地址或其他敏感信息。公开昵称来自你的读者账户。</p><button class="button" type="submit">提交审核</button></form></div>}
    <noscript><p>评论需要启用 JavaScript。文章阅读不受影响。</p></noscript>
  </>}
</section>
<script>import '../scripts/comments';</script>
