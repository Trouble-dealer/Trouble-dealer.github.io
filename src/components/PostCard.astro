---
import type { Post } from '../lib/blog';
import { categoryUrl, formatDate, postUrl, readingMinutes, tagUrl, url } from '../lib/blog';
import Icon from './Icon.astro';
interface Props { post: Post; index?: number; }
const { post, index = 0 } = Astro.props;
---
<article class="post-card card">
  <div class="post-card-content">
    <div class="post-eyebrow">{post.data.pinned ? <span class="pin-label"><Icon name="pin" size={13} /> 置顶</span> : <span class="muted">NOTE {String(index + 1).padStart(2, '0')}</span>}<a href={categoryUrl(post.data.category)}>{post.data.category}</a></div>
    <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
    <div class="post-meta"><span><Icon name="calendar" size={14} /><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time></span><span><Icon name="clock" size={14} />{readingMinutes(post)} 分钟阅读</span></div>
    <p class="post-description">{post.data.description}</p>
    <div class="post-bottom"><div class="tag-row">{post.data.tags.slice(0, 3).map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div><a class="read-link" href={postUrl(post)} aria-label={`阅读：${post.data.title}`}><Icon name="arrow" size={19}/></a></div>
  </div>
  <a class:list={['post-cover', `tone-${post.data.color}`]} href={postUrl(post)} aria-label={`阅读：${post.data.title}`} tabindex="-1" aria-hidden="true">
    {post.data.cover ? <img src={url(post.data.cover)} alt="" loading="lazy" width="320" height="300" /> : <><span class="cover-index">{String(index + 1).padStart(2, '0')}</span><span class="cover-geometry"></span><span class="cover-word">{post.data.category}<span>FIELD NOTES / ELIO</span></span></>}
  </a>
</article>
