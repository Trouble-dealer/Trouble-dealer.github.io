---
import { url } from '../lib/blog';
---
<dialog class="quiet-key-dialog" data-quiet-key data-bundle={url('assets/quiet-moment.enc.json')} aria-label="输入">
  <form autocomplete="off"><input type="password" autocomplete="off" aria-label="输入" spellcheck="false" autocapitalize="off" enterkeyhint="go" maxlength="128" /><button type="submit" aria-label="确定">↗</button></form>
</dialog>
<dialog class="quiet-scene-dialog" data-quiet-scene aria-label="独处片刻"></dialog>
<script>import '../scripts/quiet-door';</script>
<style>
  .quiet-key-dialog{position:fixed;inset:0;margin:auto;width:min(270px,calc(100vw - 56px));border:1px solid var(--line);border-radius:16px;padding:16px;background:var(--surface);box-shadow:0 22px 80px #0003;color:var(--text)}
  .quiet-key-dialog::backdrop{background:#13151b55;backdrop-filter:blur(7px)}
  .quiet-key-dialog form{display:flex;align-items:center;gap:8px;margin:0}
  .quiet-key-dialog input{width:100%;min-width:0;padding:10px 8px;border:0;border-bottom:1px solid var(--line);background:transparent;color:inherit;outline-offset:3px;font:16px system-ui;letter-spacing:3px}
  .quiet-key-dialog button{border:0;border-radius:9px;width:34px;height:36px;background:var(--surface-alt);color:var(--text);cursor:pointer;flex-shrink:0;font-size:20px}
  .quiet-scene-dialog{position:fixed;inset:0;margin:0;padding:0;width:100vw;max-width:none;height:100dvh;max-height:none;border:0;background:#180f1c;overflow:hidden}
  .quiet-scene-dialog::backdrop{background:#180f1c}
  .quiet-scene-dialog :global(iframe){display:block;width:100%;height:100%;border:0}
</style>
