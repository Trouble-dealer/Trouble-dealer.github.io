---
import { url } from '../lib/blog';
import Icon from './Icon.astro';
interface Props { current: number; total: number; }
const { current, total } = Astro.props;
const href = (n: number) => n === 1 ? url('') : url(`page/${n}/`);
---
{total > 1 && <nav class="pagination" aria-label="文章分页">
  {current > 1 ? <a href={href(current - 1)} aria-label="上一页"><Icon name="back" size={17}/></a> : <span class="pagination-disabled" aria-hidden="true"><Icon name="back" size={17}/></span>}
  {Array.from({ length: total }, (_, i) => i + 1).map(n => <a href={href(n)} class:list={[{ selected: n === current }]} aria-current={n === current ? 'page' : undefined}>{n}</a>)}
  {current < total ? <a href={href(current + 1)} aria-label="下一页"><Icon name="arrow" size={17}/></a> : <span class="pagination-disabled" aria-hidden="true"><Icon name="arrow" size={17}/></span>}
</nav>}
