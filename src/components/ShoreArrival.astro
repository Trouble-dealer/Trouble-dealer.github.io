<dialog id="shore-arrival" aria-label="海岸序章" class="shore-arrival" tabindex="-1">
  <canvas id="shore-canvas" aria-hidden="true"></canvas>
  <div class="shore-fallback" hidden aria-hidden="true">Any one<small>Elio</small></div>
  <div class="shore-shade" aria-hidden="true"></div>
  <div class="shore-topline"><span>ELIO <i>/</i> A QUIET SHORE</span><button type="button" id="shore-skip">跳过动画 <span aria-hidden="true">↗</span></button></div>
  <div class="shore-enter"><p class="shore-caption">让海浪带走喧嚣，把片刻留给自己。</p><button id="shore-enter" type="button" disabled>Enter <span aria-hidden="true">↗</span></button><span class="shore-coordinate" aria-hidden="true">ANY ONE · A PLACE TO BEGIN</span></div>
  <p class="shore-accessible" id="shore-status" role="status" aria-live="polite">海浪正涌向沙滩。</p>
</dialog>
<script>import '../scripts/shore-arrival';</script>
<style is:global>
  html[data-shore=pending]{overflow:hidden}
  html[data-shore=pending] body>:not(#shore-arrival){visibility:hidden}
  .shore-arrival{position:fixed;inset:0;width:100vw;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;overflow:hidden;background:linear-gradient(160deg,#2d424b 45%,#aaa99a 80%);color:#edf0e8;isolation:isolate}
  .shore-arrival::backdrop{background:#35494f}.shore-arrival canvas{position:absolute;inset:0;width:100%;height:100%;z-index:0}
  .shore-arrival:focus{outline:none}
  .shore-fallback{position:absolute;top:55%;left:50%;transform:translate(-50%,-50%);font:italic clamp(42px,9vw,100px) Georgia,serif;white-space:nowrap;color:#33484b;z-index:1}.shore-fallback small{display:block;text-align:right;font-size:.3em;margin-top:12px}
  .shore-shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,#12293030,transparent 45%,#14252b12);z-index:1}
  .shore-topline{position:absolute;z-index:2;top:max(28px,env(safe-area-inset-top));left:max(36px,env(safe-area-inset-left));right:max(36px,env(safe-area-inset-right));display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:3px;color:#e1e9e1aa}
  .shore-topline i{font-style:normal;opacity:.5;padding:0 12px}.shore-topline button{background:transparent;color:inherit;font-size:10px;letter-spacing:1px;padding:10px 0 10px 12px;border:0}.shore-topline button:hover{color:#fff}.shore-topline button span{padding-left:7px}
  .shore-enter{position:absolute;left:0;right:0;bottom:max(7vh,25px);z-index:2;display:flex;align-items:center;flex-direction:column;gap:17px;opacity:0;visibility:hidden;transform:translateY(14px);transition:opacity 1.1s ease,transform 1.1s ease,visibility 1.1s}
  .shore-arrival.is-ready .shore-enter{opacity:1;visibility:visible;transform:translateY(0)}
  .shore-caption{font:11px/1.8 "Songti SC",SimSun,serif;letter-spacing:3px;color:#273f43;margin:0;text-shadow:0 1px 0 #ffffff40}
  #shore-enter{display:flex;align-items:center;justify-content:space-between;gap:60px;min-width:190px;padding:16px 24px;border-radius:12px;border:1px solid #ffffff66;background:linear-gradient(125deg,#ffffff38,#ffffff0f);box-shadow:inset 0 1px 0 #fff5,0 7px 28px #233b4018;backdrop-filter:blur(18px) saturate(1.25);-webkit-backdrop-filter:blur(18px) saturate(1.25);color:#233c40;font:italic 24px Georgia,serif;cursor:pointer;transition:background .25s,transform .25s}
  #shore-enter span{font:18px system-ui;opacity:.65}#shore-enter:hover{background:#ffffff50;transform:translateY(-2px)}#shore-enter:focus-visible{outline:2px solid #243f48;outline-offset:5px}.shore-coordinate{font:8px Georgia,serif;letter-spacing:3px;color:#324b4f99}
  .shore-accessible{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .shore-arrival.is-leaving{opacity:0;transition:opacity .8s ease;pointer-events:none}
  @media(max-width:600px){.shore-topline{left:23px;right:23px;top:max(17px,env(safe-area-inset-top));font-size:7px;letter-spacing:2px}.shore-topline i{padding:0 7px}.shore-caption{font-size:10px;letter-spacing:1.5px}.shore-enter{bottom:max(7vh,25px);gap:16px}#shore-enter{padding:15px 22px;min-width:180px;font-size:23px}}
  @media(max-height:600px){.shore-enter{bottom:18px;gap:10px}.shore-caption{font-size:9px}#shore-enter{padding:10px 22px;font-size:21px}.shore-coordinate{display:none}}
  @media(prefers-reduced-motion:reduce){.shore-enter,.shore-arrival.is-leaving{transition:none}#shore-enter{transition:none}}
</style>
