---
import {url} from '../lib/blog';
---
<dialog id="shore-arrival" aria-label="海岸序章" class="shore-arrival" tabindex="-1">
  <video id="shore-video" autoplay muted playsinline preload="auto" disablepictureinpicture aria-hidden="true" tabindex="-1"><source src={url('images/shore-arrival.mp4')} type="video/mp4" /></video>
  <div class="shore-shade" aria-hidden="true"></div>
  <div class="shore-topline"><span>ELIO <i>/</i> A QUIET SHORE</span><button type="button" id="shore-skip">跳过动画 <span aria-hidden="true">↗</span></button></div>
  <div class="shore-writing" aria-hidden="true"><span>Any one</span><small>Elio</small></div>
  <div class="shore-enter"><p class="shore-caption">让海浪带走喧嚣，把片刻留给自己。</p><button id="shore-enter" type="button" disabled>Enter <span aria-hidden="true">↗</span></button><span class="shore-coordinate" aria-hidden="true">ANY ONE · A PLACE TO BEGIN</span></div>
  <p class="shore-accessible" id="shore-status" role="status" aria-live="polite">开场视频正在播放。</p>
</dialog>
<script>import '../scripts/shore-arrival';</script>
<style is:global>
  html[data-shore=pending]{overflow:hidden}
  html[data-shore=pending] body>:not(#shore-arrival){visibility:hidden}
  .shore-arrival{position:fixed;inset:0;width:100vw;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;overflow:hidden;background:linear-gradient(#d9dde2 20%,#69717c 48%,#151619 70%);color:#edf0e8;isolation:isolate}
  .shore-arrival::backdrop{background:#17232c}#shore-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:0}
  .shore-arrival:focus{outline:none}
  .shore-writing{position:absolute;left:8vw;bottom:9vh;z-index:2;opacity:0;transform:translateY(12px);transition:opacity 1.2s ease,transform 1.2s ease;color:#f4f3ed;text-shadow:0 2px 20px #08131f70;font:italic clamp(52px,7vw,92px)/1.1 "Segoe Script","Apple Chancery",Georgia,serif;white-space:nowrap;pointer-events:none}.shore-writing small{display:block;text-align:right;font-size:.3em;margin:10px 8px 0 0;letter-spacing:1px}.shore-arrival.has-writing .shore-writing{opacity:1;transform:translateY(0)}
  .shore-shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,#0a142b3d,transparent 24%,transparent 51%,#07131f45 75%,#07131fbd);z-index:1}
  .shore-topline{position:absolute;z-index:2;top:max(28px,env(safe-area-inset-top));left:max(36px,env(safe-area-inset-left));right:max(36px,env(safe-area-inset-right));display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:3px;color:#edf1f2d9;text-shadow:0 1px 8px #0005}
  .shore-topline i{font-style:normal;opacity:.5;padding:0 12px}.shore-topline button{background:transparent;color:inherit;font-size:10px;letter-spacing:1px;padding:10px 0 10px 12px;border:0}.shore-topline button:hover{color:#fff}.shore-topline button span{padding-left:7px}
  .shore-enter{position:absolute;right:8vw;bottom:max(9vh,25px);z-index:2;display:flex;align-items:center;flex-direction:column;gap:17px;opacity:0;visibility:hidden;transform:translateY(14px);transition:opacity 1.1s ease,transform 1.1s ease,visibility 1.1s}
  .shore-arrival.is-ready .shore-enter{opacity:1;visibility:visible;transform:translateY(0)}
  .shore-caption{font:11px/1.8 "Songti SC",SimSun,serif;letter-spacing:3px;color:#e1e5e7;margin:0;text-shadow:0 1px 5px #0008}
  #shore-enter{display:flex;align-items:center;justify-content:space-between;gap:60px;min-width:190px;padding:16px 24px;border-radius:12px;border:1px solid #ffffff66;background:linear-gradient(125deg,#ffffff26,#ffffff0a);box-shadow:inset 0 1px 0 #fff3,0 7px 28px #0003;backdrop-filter:blur(18px) saturate(1.1);-webkit-backdrop-filter:blur(18px) saturate(1.1);color:#f0f2ef;font:italic 24px Georgia,serif;cursor:pointer;transition:background .25s,transform .25s}
  #shore-enter span{font:18px system-ui;opacity:.65}#shore-enter:hover{background:#ffffff30;transform:translateY(-2px)}#shore-enter:focus-visible{outline:2px solid #e2e9ed;outline-offset:5px}.shore-coordinate{font:8px Georgia,serif;letter-spacing:3px;color:#c8d1d4aa}
  .shore-accessible{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .shore-arrival.is-leaving{opacity:0;transition:opacity .8s ease;pointer-events:none}
  @media(max-width:600px){.shore-arrival{background:#15212a}#shore-video{height:64%;object-position:54% center}.shore-shade{background:linear-gradient(180deg,#15212a26,transparent 25%,transparent 44%,#15212a 72%)}.shore-writing{left:50%;bottom:24%;font-size:56px;transform:translate(-50%,12px)}.shore-arrival.has-writing .shore-writing{transform:translate(-50%,0)}.shore-topline{left:23px;right:23px;top:max(17px,env(safe-area-inset-top));font-size:7px;letter-spacing:2px}.shore-topline i{padding:0 7px}.shore-caption{font-size:10px;letter-spacing:1.5px}.shore-enter{left:0;right:0;bottom:max(6vh,25px);gap:16px}#shore-enter{padding:15px 22px;min-width:180px;font-size:23px}}
  @media(max-height:600px){.shore-enter{bottom:18px;gap:10px}.shore-caption{font-size:9px}#shore-enter{padding:10px 22px;font-size:21px}.shore-coordinate{display:none}}
  @media(prefers-reduced-motion:reduce){.shore-writing,.shore-enter,.shore-arrival.is-leaving{transition:none}#shore-enter{transition:none}}
</style>
