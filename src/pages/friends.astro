---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../../site.config.mjs';
const groups = [
  { title: '同路人的博客', subtitle: '在自己的角落，记录各自的宇宙。', items: siteConfig.friends.filter(friend => friend.kind === 'friend') },
  { title: '灵感与开源', subtitle: '为这个小站带来帮助的工具与设计参考。', items: siteConfig.friends.filter(friend => friend.kind !== 'friend') },
];
---
<BaseLayout title="友链与灵感">
  <header class="page-intro card"><p class="eyebrow">THE INTERNET IS A GARDEN</p><h1>友链与灵感</h1><p>去朋友的文字里坐坐，也向帮助这个小站诞生的开源项目致谢。</p></header>
  {groups.filter(group => group.items.length).map(group => <section class="friends-section" aria-label={group.title}>
    <div class="friends-section-heading"><h2>{group.title}</h2><p>{group.subtitle}</p></div>
    <div class="friends-grid">{group.items.map(friend => <article class="card friend-card">
      <a href={friend.url} class="friend-main" target="_blank" rel="noopener noreferrer">
        <span class="friend-avatar" style={`background:${friend.color}`} aria-hidden="true"><span>{friend.name.slice(0,1)}</span>{friend.avatar && <img data-friend-avatar src={friend.avatar} alt="" width="52" height="52" loading="lazy" decoding="async" referrerpolicy="no-referrer"/>}</span>
        <div class="friend-title"><h3>{friend.name}</h3><Icon name="external" size={15}/></div><p>{friend.description}</p>
      </a>
      {friend.rss && <a href={friend.rss} class="friend-rss" target="_blank" rel="noopener noreferrer" type="application/rss+xml" aria-label={`订阅 ${friend.name} 的 RSS`}><Icon name="rss" size={14}/>RSS 订阅<Icon name="arrow" size={14}/></a>}
    </article>)}</div>
  </section>)}
  <section class="card content-card"><div class="prose"><h2 style="margin-top:0">关于这份清单</h2><p>「同路人的博客」收录朋友的个人站点；「灵感与开源」列出本站使用的工具与设计参考，后者不代表互换友链关系。</p>{siteConfig.email && <p>如果你想交换友链，可以<a href={`mailto:${siteConfig.email}?subject=${encodeURIComponent('友链交流')}`}>给我写信</a>，附上站点名称、网址和一句介绍，也可以提供头像与 RSS 地址。</p>}</div></section>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLImageElement>('[data-friend-avatar]').forEach(image => {
    const fallback = () => { image.hidden = true; };
    image.addEventListener('error', fallback, {once:true});
    if (image.complete && !image.naturalWidth) fallback();
  });
</script>
<style>
  .friends-section-heading{margin:27px 0 17px}.friends-section-heading h2{font-size:16px;letter-spacing:.5px}.friends-section-heading p{font-size:11px;color:var(--muted);line-height:1.9;margin-top:6px}
  .friend-card{padding:0;overflow:hidden;display:flex;flex-direction:column}.friend-card:hover{border-color:color-mix(in srgb,var(--accent) 35%,var(--line))}.friend-main{display:block;padding:25px;flex:1}.friend-main:hover h3{color:var(--accent)}.friend-title h3{font-size:16px;font-weight:600;transition:color .2s}.friend-avatar{position:relative;overflow:hidden;width:52px;height:52px;box-shadow:inset 0 1px 0 #ffffff66}.friend-avatar img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .friend-rss{display:flex;align-items:center;gap:8px;padding:12px 25px;border-top:1px solid var(--line);font-size:11px;color:var(--accent);background:var(--surface-alt)}.friend-rss>:last-child{margin-left:auto}.friend-rss:hover{background:var(--accent-soft)}
  @media(max-width:460px){.friend-main{padding:23px}.friend-rss{padding:12px 23px}}
</style>
