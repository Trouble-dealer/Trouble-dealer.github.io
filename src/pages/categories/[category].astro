---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, taxonomy, url } from '../../lib/blog';
export async function getStaticPaths() {
  const posts = await getPosts();
  return taxonomy(posts, 'category').map(([category]) => ({ params: { category }, props: { category, posts: posts.filter(p => p.data.category === category) } }));
}
const { category, posts } = Astro.props;
---
<BaseLayout title={`${category} · 分类`}><header class="page-intro card"><a class="back-link" href={url('categories/')}><Icon name="back" size={14}/>所有分类</a><p class="eyebrow">EXPLORE BY CATEGORY</p><h1>{category}</h1><p>这个话题下，共有 {posts.length} 篇记录。</p></header><div class="post-list">{posts.map((post, index) => <PostCard post={post} index={index}/>)}</div></BaseLayout>
